{
  "name": "plateau-mvt-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PLATEAU MVTを2D・3Dで検証する静的Webアプリ",
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2",
    "three": "0.185.1"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:clean": "node scripts/dev.js",
    "build:mvt-index": "node tools/build-mvt-index/build.js",
    "build:mvt-index:offline": "set SKIP_CATALOG_FETCH=1&& set REUSE_MANIFESTS=1&& node tools/build-mvt-index/build.js",
    "check:boundaries": "node --check tools/build-mvt-index/admin-boundaries.js && node scripts/check-admin-boundaries.js",
    "check:mvt-style": "node --check web/shared/mvt/feature-style.js && node scripts/check-mvt-style.js",
    "check:web-paths": "node scripts/check-web-paths.js",
    "precheck": "npm run check:boundaries && npm run check:mvt-style && npm run check:web-paths",
    "check": "node scripts/check-source.js && node scripts/check-mesh.js && node scripts/check-indexed-mvt.js",
    "probe:kyoto-mvt": "node scripts/probe-kyoto-mvt.js",
    "probe:kyoto-usedistrict": "node scripts/probe-kyoto-usedistrict.js",
    "generate:g2-preview": "node scripts/generate-g2-preview-sample.js",
    "dev:even-g2": "npm run dev --prefix web/viewers/even-g2/hub-app"
  },
  "engines": {
    "node": ">=20"
  }
}
